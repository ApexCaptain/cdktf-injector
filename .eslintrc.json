  },
  "ignorePatterns": [
    "*.js",
    "*.d.ts",
    "node_modules/",
    "*.generated.ts",
    "coverage",
    "/.pnpm-store/*",
    "tmp/",
    "!.projenrc.ts",
    "!projenrc/**/*.ts"
  ],
  "rules": {
    "curly": [
      "error",
      "multi-line",
      "consistent"
    ],
    "@typescript-eslint/no-require-imports": "error",
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/test/**",
          "**/tasks/**",
          "**/projenrc/**",
          ".projenrc.ts",
          "projenrc/**/*.ts"
        ],
        "optionalDependencies": false,
        "peerDependencies": true
      }
    ],
    "import/no-unresolved": [
      "error"
    ],
    "import/order": [
      "warn",
      {
        "groups": [
