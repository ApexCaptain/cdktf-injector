          "mcp",
          "npmignore",
          "octokit",
          "outdir",
          "pipenet",
          "pnpm",
          "postinstall",
          "prettierignore",
          "prettierrc",
          "projen",
          "projenrc",
          "rc",
          "repo",
          "repos",
          "rmdir",
          "rulesync",
          "signoff",
          "srcdir",
          "stash",
          "testdir",
          "tldjs",
          "tsconfig",
